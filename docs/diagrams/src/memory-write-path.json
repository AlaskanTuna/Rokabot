  "cards": [
    {
      "dot": "emerald",
      "title": "Main Path",
      "items": [
        "Monitored guild messages form episodes; a 180 s lull or 25 deltas closes one",
        "The queue insert and cursor advance share one SQLite transaction",
        "Verified operations write active claims; incomplete verification stages candidates"
      ]
    },
    {
      "dot": "rose",
      "title": "Drops and Retries",
      "items": [
        "Precheck drops sensitive or wholly trivial episodes locally",
        "No judge, a timeout or a probability below threshold drops the episode",
        "Transient errors retry after 1, 5, 20 and 60 minutes; jev_unavailable retries once after 5 minutes"
      ]
    },
    {
      "dot": "cyan",
      "title": "Judge",
      "items": [
        "Jev when TYPESAFE_API_KEY is set",
        "Main model when an llm: block exists and the key is not set",
        "Neither: every episode is dropped"
      ]
    }
  ]
