  "cards": [
    {
      "dot": "cyan",
      "title": "Order Matters",
      "items": [
        "The peek is advisory; reserveCalls is authoritative",
        "Declines before reserveCalls hold nothing",
        "A byte refusal hands the slots and daily unit back with release(0)"
      ]
    },
    {
      "dot": "amber",
      "title": "Release to the Truth",
      "items": [
        "release(used) keeps the calls the turn made and frees the rest",
        "A thrown turn keeps its whole reservation",
        "Text turns skip the token floor"
      ]
    }
