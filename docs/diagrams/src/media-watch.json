  "cards": [
    {
      "dot": "cyan",
      "title": "Watcher Modes",
      "items": [
        "gemini (default) or qwen watches first; the other is the backup",
        "direct sends audio and video to the reply model as they arrived",
        "off turns each audio or video item into a notice",
        "Images and PDFs skip the watchers in every mode"
      ]
    },
    {
      "dot": "amber",
      "title": "Admission Limits",
      "items": [
        "Up to 10 files and one audio or video item per turn",
        "Bytes are reserved before any download starts",
        "A watch plan must fit gemini.maxAttachmentTokens"
      ]
    }
  ]
