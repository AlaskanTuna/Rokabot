  "cards": [
    {
      "dot": "rose",
      "title": "Safety Rungs",
      "items": [
        "1 drop_overheard: overheard, looked-up and reply-shape blocks go; a redirect note is added",
        "2 drop_facts: memory, server facts, episodes and media memory go",
        "3 clear_history: sincere tone, empty session, no images or watched media"
      ]
    },
    {
      "dot": "amber",
      "title": "Which Line",
      "items": [
        "safety, refusal: the safety line",
        "recitation: the recitation line",
        "terminal, session_corrupt, context_length: the terminal line",
        "every other kind: a random generic line"
      ]
    },
    {
      "dot": "slate",
      "title": "Session Actions",
      "items": [
        "terminal destroys the session",
        "session_corrupt resets it before its one retry",
        "shutdown ends the loop with the last kind's line"
      ]
    }
  ]
