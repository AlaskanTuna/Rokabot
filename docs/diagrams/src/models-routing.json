  "cards": [
    {
      "dot": "rose",
      "title": "Switch and Sticky Kinds",
      "items": [
        "Switch: transient_http, network, quota_exhausted, billing_exhausted, refusal, malformed_tool_args, context_length",
        "Open the window: only the first three, once the fallback answers",
        "A main-side answer closes the window"
      ]
    },
    {
      "dot": "cyan",
      "title": "Hedge Rules",
      "items": [
        "Off while llm.hedgeAfterMs is 0, the shipped value",
        "Skipped when pinned, already on the fallback, or with non-image media",
        "The loser is aborted; if both fail, the main error goes on"
      ]
    },
    {
      "dot": "violet",
      "title": "Pinning",
      "items": [
        "On when either side is Claude, which replays thinking",
        "The first answer pins the turn's later calls",
        "A switch clears the pin"
      ]
    }
  ]
