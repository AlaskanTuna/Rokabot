  "cards": [
    {
      "dot": "orange",
      "title": "Fixed Roll Order",
      "items": [
        "Paragraphs, opener style, opener word or bit, ending, face shuffle, beats, threat",
        "A hard line skips the ending roll: the ending is always a statement",
        "Every beat the edge allows rolls, even at zero odds"
      ]
    },
    {
      "dot": "rose",
      "title": "Edge",
      "items": [
        "Hard: a hard-line word, or a minor word with a sexual word",
        "Lewd: a lewd word or phrase",
        "Her own quoted reply is not read"
      ]
    },
    {
      "dot": "slate",
      "title": "No Repeats",
      "items": [
        "Opener words skip her last 3 first words",
        "Faces skip her last 5 replies and the user's message",
        "Threats skip her last 3 replies"
      ]
    }
