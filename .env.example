# Required secrets (tunables are in config.yml)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Required only when a role uses Gemini: the main or fallback model, gemini embeddings, or media.watcher: gemini.
# The legacy config (no llm: block in config.yml) runs a Gemini main model, so it always needs this key
GEMINI_API_KEY=

# Optional: dev key used by the harness for opt-in live runs (--live); never use GEMINI_API_KEY there
GRAPHIFY_GEMINI_API_KEY=
# Optional: a second dev key. Set ROKABOT_HARNESS_KEY=DEV_GEMINI_API_KEY to fund a live run from it
# when the default key's project has spent its daily quota.
DEV_GEMINI_API_KEY=

# Optional: SQLite database path override (use :memory: for isolated harness runs)
ROKABOT_DB_PATH=

# Optional: config.yml path override (tests point it at a copy without the llm: block)
ROKABOT_CONFIG_PATH=

# Optional: Tavily API key for web search (free: 1000 queries/month)
# Sign up at https://tavily.com to get a key
TAVILY_API_KEY=

# Optional: YouTube Data API v3 key (Google Cloud, restricted to youtube.googleapis.com) for reading the top
# comments on linked YouTube videos; without it, YouTube replies report as unavailable
YOUTUBE_API_KEY=

# Optional: ModelScope API-Inference token. It funds the legacy Qwen fallback (Qwen/Qwen3.5-122B-A10B), the qwen
# media watcher, and any llm.models entry with provider: modelscope (Qwen and DeepSeek share one Magicube balance)
MODELSCOPE_API_KEY=

# Optional: Anthropic API key, required only when llm.main or llm.fallback in config.yml uses provider anthropic
ANTHROPIC_API_KEY=

# Optional: OpenAI API key, required only when llm.main or llm.fallback is a provider: openai model (gpt-6-luna)
# or embeddings.provider is openai
OPENAI_API_KEY=

# Optional: TypeSafe API key for Jev judgments; without it, the main model judges passive memory when config.yml
# has an llm: block, and passive memory extraction drops all episodes when it does not
TYPESAFE_API_KEY=

# Optional (docker compose installs): image tag to run. Defaults to stable, which moves only on a release.
# Pin one release with vX.Y.Z, or follow one minor line with vX.Y
# ROKA_TAG=stable

# Optional (docker compose installs): set to autoupdate to start Watchtower, which pulls a newer image for the tag
# above and restarts the bot. Needs the Docker socket; off by default
# COMPOSE_PROFILES=autoupdate

# Optional (docker compose installs): speech-to-text sidecar URL for the qwen media watcher. Compose defaults it to
# http://asr:8000; set it empty to turn speech recognition off
# MEDIA_TRANSCRIBER_URL=

# Optional: set to false to stop the bot from DMing its owner about a new GitHub release (updates.notify in config.yml)
# UPDATES_NOTIFY=false
